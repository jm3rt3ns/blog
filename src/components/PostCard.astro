---
import type { Post } from '../lib/collections';
import { formatDate, isoDate } from '../lib/format-date';
import { tagLabel } from '../lib/tags';

interface Props {
  post: Post;
  /** Index cards lead with an h2; the home page nests them under one. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const href = `/writing/${post.id}/`;
---

<article class="group border-t border-rule pt-5">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <time datetime={isoDate(post.data.pubDate)} class="field-label">
      {formatDate(post.data.pubDate)}
    </time>
    {post.data.draft && <span class="field-label text-mark">Draft</span>}
  </div>

  <Heading class="mt-2 text-lg">
    <a href={href} class="text-ink no-underline group-hover:text-signal">
      {post.data.title}
    </a>
  </Heading>

  <p class="mt-2 text-graphite">{post.data.description}</p>

  {
    post.data.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 list-none p-0">
        {post.data.tags.map((tag) => (
          <li>
            <a href={`/writing/tags/${tag}/`} class="field-label hover:text-signal no-underline">
              {tagLabel(tag)}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
