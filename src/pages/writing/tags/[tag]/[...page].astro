---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import {
  allTags,
  postsByTag,
  POSTS_PER_PAGE,
  type Post,
} from '../../../../lib/collections';
import { tagLabel } from '../../../../lib/tags';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const isDev = import.meta.env.DEV;
  const posts = await getCollection('posts');

  return allTags(posts, isDev).flatMap((tag) =>
    paginate(postsByTag(posts, isDev, tag), {
      params: { tag },
      pageSize: POSTS_PER_PAGE,
    }),
  );
};

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const tag = String(Astro.params.tag);
const label = tagLabel(tag);
---

<BaseLayout
  title={`Tagged “${label}”`}
  description={`Every post tagged ${label} — ${page.total} in total, newest first.`}
>
  <header class="border-b border-rule pb-5">
    <p class="field-label">Tag</p>
    <h1 class="mt-2 text-2xl">{label}</h1>
    <p class="mt-3 text-graphite">
      {page.total}
      {page.total === 1 ? 'post' : 'posts'}.
      <a href="/writing/">All writing</a>
    </p>
  </header>

  <div class="mt-10 grid gap-10">
    {page.data.map((post) => <PostCard post={post} />)}
  </div>

  <Pagination page={page} />
</BaseLayout>
