---
import type { GetStaticPaths, Page } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { publishedPosts, tagCounts, POSTS_PER_PAGE, type Post } from '../../lib/collections';
import { tagLabel } from '../../lib/tags';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = publishedPosts(await getCollection('posts'), import.meta.env.DEV);
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
};

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const counts = tagCounts(await getCollection('posts'), import.meta.env.DEV);
const tags = [...counts.entries()].sort(([a], [b]) => a.localeCompare(b));

const title = page.currentPage > 1 ? `Writing — page ${page.currentPage}` : 'Writing';
---

<BaseLayout
  title={title}
  description="Long-form writing on software, systems and the practice of building things carefully."
>
  <header class="border-b border-rule pb-5">
    <h1 class="text-2xl">Writing</h1>
    <p class="mt-3 text-graphite">
      {page.total}
      {page.total === 1 ? 'post' : 'posts'}, newest first.
    </p>
  </header>

  {
    tags.length > 0 && (
      <nav aria-label="Tags" class="mt-5">
        <ul class="flex flex-wrap gap-x-4 gap-y-1 list-none p-0">
          {tags.map(([tag, count]) => (
            <li>
              <a href={`/writing/tags/${tag}/`} class="field-label hover:text-signal no-underline">
                {tagLabel(tag)} ({count})
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div class="mt-10 grid gap-10">
    {page.data.map((post) => <PostCard post={post} />)}
  </div>

  <Pagination page={page} />
</BaseLayout>
