# Cloudflare Pages response headers.
# Syntax: a path pattern, then indented `Header: value` lines.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()

# Astro fingerprints everything under /_astro/, so the URL changes whenever the
# content does. Safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are NOT fingerprinted — they are served from public/ under stable
# names. Immutable is still right, but it means replacing a face requires
# renaming the file, or readers keep the cached copy for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is deliberately not given a Cache-Control rule here. Pages already
# serves it as `public, max-age=0, must-revalidate`, and a pattern that
# reliably matches directory URLs like /writing/ would also match the two
# immutable prefixes above — leaving the winner up to Pages' merge order.
# docs/deployment.md has a curl to verify the default after the first deploy.
